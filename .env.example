# Copy to .env in the project root. Keep real values local.
# Use separate randomly generated hexadecimal passwords.
POSTGRES_PASSWORD=REPLACE_WITH_ADMIN_HEX_PASSWORD
CHAT_APP_PASSWORD=REPLACE_WITH_APP_HEX_PASSWORD
# Compose derives SERVER_DATABASE_URL from CHAT_APP_PASSWORD and db:5432.
# Use the public key of the same Ed25519 identity as the client.
SERVER_DEMO_IDENTITIES='[{"user_id":"alice","api_token":"REPLACE_WITH_TOKEN","signing_public_key_b64":"REPLACE_WITH_STANDARD_BASE64_PUBLIC_KEY"}]'

# Keep disabled outside isolated tests until the invitation cutover in Step 3.
SERVER_PUBLIC_SIGNUP_ENABLED=false